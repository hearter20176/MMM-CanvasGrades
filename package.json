    "eslint-plugin-package-json": "^1.10.1",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "engines": {
    "node": ">=20"
  }
